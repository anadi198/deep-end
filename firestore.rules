rules_version = '2';
// Only the owner's account can read or write, so a copied web config is useless to anyone else.
// Replace OWNER_UID with your Firebase Auth user id (Firebase console → Authentication → Users)
// in the console copy before publishing; the repo keeps the placeholder.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid && uid == 'OWNER_UID';
    }
  }
}
